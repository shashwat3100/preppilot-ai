{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PrepPilot AI Backend Server (Port 5000)",
      "type": "shell",
      "command": "npm run dev:server",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^([^:]+):(\\d+):?(\\d+)?:?\\s+(warning|error):?\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*PrepPilot AI Server running.*",
          "endsPattern": ".*Ready.*"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start PrepPilot AI Full Stack (Backend + Vite Client)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
